# ------------------------------------------------------------------------------
# 4. INTERNAL TREASURY HOT WALLET (BNB SMART CHAIN / BEP-20 USDT — Chain ID 56)
# ------------------------------------------------------------------------------
# CRITICAL: Never generate wallets automatically in application runtime.
# Provision an external hardware/custody-backed BSC wallet and inject its
# 32-byte hex private key strictly via server-side secret manager.
# Never expose RPC configuration, treasury secrets, or private keys in VITE_* variables.
TREASURY_HOT_WALLET_ADDRESS="0x19FaF16d0a8fb7EdBf31b4AbeC06bc4Bfbf9467B"
TREASURY_HOT_WALLET_PRIVATE_KEY=""
TREASURY_HOT_WALLET_NETWORK="BSC"
BSC_RPC_URL="https://PRIMARY_BSC_RPC"
BSC_RPC_FALLBACK_URLS="https://SECONDARY_RPC,https://TERTIARY_RPC"
BSC_RPC_TIMEOUT_MS="4000"
BSC_RPC_MAX_BLOCK_AGE_SECONDS="60"

# Operational Treasury Safety Limits (Requirement 4, 6 & 9)
TREASURY_MIN_WITHDRAWAL_USD="10"
TREASURY_MAX_WITHDRAWAL_PER_TX_USD="2500"
TREASURY_HOURLY_LIMIT_USD="5000"
TREASURY_DAILY_LIMIT_USD="15000"
TREASURY_MAX_HOT_WALLET_BALANCE_USD="20000"
TREASURY_MIN_GAS_RESERVE_BNB="0.005"

