# Copy to .env locally. Never commit .env or real credentials.
NODE_ENV=production
SYSTEM_OPERATING_MODE=PRODUCTION
PORT=3000
APP_URL=https://your-domain.example

# Generate independent random secrets (at least 32 characters each).
API_AUTH_TOKEN=
OWNER_API_KEY=
OWNER_OVERRIDE_KEY=
V13_BRIDGE_TOKEN=
V13_BRIDGE_URL=

# PostgreSQL: use a strong secret and keep the database private.
PGHOST=postgres
PGPORT=5432
PGDATABASE=arbitrage_v13
PGUSER=arbitrage_app
PGPASSWORD=

# Optional provider credentials; never expose in browser code.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_TARGET_UID=
SYSTEM_USDT_ADDRESS=
SYSTEM_TRON_ADDRESS=
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=

# Payments remain sandboxed unless provider credentials and verification are configured.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
PAYFAST_NOTIFY_URL=/api/payments/payfast/notify
GOTYME_PARTNER_ID=
GOTYME_CLIENT_SECRET=
GOTYME_SANDBOX=true

# Set only from a dated, verified FX source before currency conversions.
USD_ZAR_RATE=

# Optional GitHub sync: keep token in deployment secrets, not in this file.
GITHUB_UPSTREAM_REPO=STEYNGROVE/GPU-Arbitrage-os
GITHUB_ACCESS_TOKEN=
GITHUB_COMMITTER_EMAIL=
GITHUB_COMMITTER_NAME=GPU Arbitrage OS
TRUSTED_IPS=127.0.0.1,::1
